@startuml C4_Context
!include <C4/C4_Context.puml>

title [C4 - Level 1] System Context: CreditFlow Platform

Person(endUser, "End User", "A SaaS customer who purchases credit packages and consumes AI-powered features.")
Person(admin, "Platform Admin", "Manages packages, monitors transactions, and administers the system.")

System(creditFlow, "CreditFlow Platform", "A SaaS credit management system. Users purchase credit packages to unlock and consume AI features. Every debit/credit is logged atomically.")

System_Ext(aiProvider, "AI Provider (Mock)", "External AI service for image generation and content automation. Access is gated by the RBAC guard.")
System_Ext(emailService, "Email Service", "Transactional email delivery for registration confirmations and purchase receipts.")

Rel(endUser, creditFlow, "Purchases packages, uses AI features, views transaction history", "HTTPS")
Rel(admin, creditFlow, "Manages packages, views all transactions, admin operations", "HTTPS")
Rel(creditFlow, aiProvider, "Delegates AI tasks after credit verification", "HTTPS / REST")
Rel(creditFlow, emailService, "Sends transactional notifications", "SMTP / TLS")

@enduml
