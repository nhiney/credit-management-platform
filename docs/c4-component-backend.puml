@startuml C4_Component_Backend
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title [C4 — Level 3] Component Diagram: NestJS API

Container_Ext(spa, "React SPA", "", "")
ContainerDb_Ext(db, "PostgreSQL", "", "")

Container_Boundary(api, "NestJS API") {

    ' ── Cross-cutting / Infrastructure ───────────────────────────────────────
    Component(correlationMw, "CorrelationIdMiddleware", "NestJS Middleware",
        "Generates a unique X-Correlation-ID (UUID v4)\nper request. Propagates it via AsyncLocalStorage\nso every log line in the request lifecycle carries the same ID.")

    Component(logInterceptor, "LoggingInterceptor", "NestJS Interceptor",
        "Logs incoming method, path, status code, and\nlatency for every HTTP call.\nReads correlation ID from context.")

    Component(exFilter, "HttpExceptionFilter", "NestJS Exception Filter",
        "Catches all exceptions. Returns a standardized\nerror envelope: { success, statusCode, timestamp,\ncorrelationId, path, message }.")

    Component(winstonLogger, "WinstonLogger", "Winston",
        "Structured JSON logger injected across all services.\nTransports: Console (dev) + File (prod).\nIncludes correlationId, level, timestamp, context.")

    ' ── Security Layer ────────────────────────────────────────────────────────
    Component(jwtGuard, "JwtAuthGuard", "NestJS Guard — APP_GUARD",
        "Validates Bearer JWT on every route.\nSkips routes decorated with @Public().")

    Component(rfGuard, "RequireFeatureGuard", "NestJS Guard",
        "RBAC logic:\n1. Resolve @RequireFeature(code) metadata.\n2. Verify user has ACTIVE package with feature.\n3. Check currentCredits >= feature.creditCost.\n4. Deduct credits + log CREDIT_OUT atomically via\n   CreditDeductionStrategy inside $transaction.\nRejects with 403 or 422 on failure.")

    Component(rolesGuard, "RolesGuard", "NestJS Guard",
        "Checks @Roles(Role.ADMIN) metadata.\nEnforced on admin-only endpoints.")

    ' ── Presentation Layer (Controllers) ─────────────────────────────────────
    Component(authCtrl, "AuthController", "NestJS Controller · /api/auth",
        "POST /register — create account\nPOST /login — return JWT")

    Component(usersCtrl, "UsersController", "NestJS Controller · /api/users",
        "GET /me — profile + active packages\nGET / — all users (Admin)")

    Component(pkgCtrl, "PackagesController", "NestJS Controller · /api/packages",
        "GET / — public list\nPOST, PATCH, DELETE — Admin CRUD")

    Component(purchaseCtrl, "PurchaseController", "NestJS Controller · /api/purchase",
        "POST / — buy a package (atomic)")

    Component(txCtrl, "TransactionsController", "NestJS Controller · /api/transactions",
        "GET /me — personal history (paginated)\nGET / — all transactions (Admin)")

    Component(aiCtrl, "AiController", "NestJS Controller · /api/ai",
        "POST /generate — image (3 credits, Pro+)\nPOST /auto-post — post (1 credit, Basic+)")

    ' ── Application Layer (Services) ─────────────────────────────────────────
    Component(authSvc, "AuthService", "NestJS Service",
        "Registration (bcrypt hash), login (bcrypt compare),\nJWT signing. Delegates persistence to UserRepository.")

    Component(usersSvc, "UsersService", "NestJS Service",
        "Fetch profile with active packages.\nAdmin: paginated user list.")

    Component(pkgSvc, "PackagesService", "NestJS Service",
        "Package CRUD. Soft-delete enforced:\ncannot delete if active subscribers exist.")

    Component(purchaseSvc, "PurchaseService", "NestJS Service",
        "Orchestrates purchase inside Prisma $transaction:\n1. Validate package exists + user hasn't bought it.\n2. Increment user.currentCredits.\n3. Create UserPackage record.\n4. Create CREDIT_IN Transaction via TransactionFactory.")

    Component(txSvc, "TransactionsService", "NestJS Service",
        "Paginated transaction history per user or global.\nDelegates to TransactionRepository.")

    Component(aiSvc, "AiService", "NestJS Service",
        "Simulates external AI calls with deliberate latency.\nOnly reached after RequireFeatureGuard passes.")

    ' ── Domain Layer ─────────────────────────────────────────────────────────
    Component(txFactory, "TransactionFactory", "Factory Pattern",
        "Single responsibility: builds a CreateTransactionDto\nwith computed balanceBefore, balanceAfter, description,\nand a deterministic referenceId for idempotency.")

    Component(creditStrategy, "CreditDeductionStrategy", "Strategy Pattern",
        "Encapsulates the credit-deduction algorithm.\nInterface: execute(userId, cost, tx): Promise<User>.\nCan be swapped for PostpaidStrategy or FreeTrialStrategy\nwithout touching the guard.")

    ' ── Infrastructure Layer (Repositories) ──────────────────────────────────
    Component(userRepo, "UserRepository", "Repository Pattern",
        "Implements IUserRepository interface.\nAll Prisma user queries go through here.\nInjected via DI token for easy mocking in tests.")

    Component(pkgRepo, "PackageRepository", "Repository Pattern",
        "Implements IPackageRepository interface.\nHandles package + package_features queries.")

    Component(txRepo, "TransactionRepository", "Repository Pattern",
        "Implements ITransactionRepository interface.\nHandles all transaction read/write operations.")

    Component(prisma, "PrismaService", "Prisma Client",
        "Global singleton. Wraps PrismaClient.\n$transaction() used for all multi-step DB operations.\nConnects/disconnects on module lifecycle hooks.")
}

' ── Relationships — Middleware / Cross-cutting ──────────────────────────────
Rel(spa, correlationMw, "All HTTP requests pass through", "")
Rel(correlationMw, logInterceptor, "Enriches log context", "")
Rel(logInterceptor, winstonLogger, "Writes structured logs", "")
Rel(exFilter, winstonLogger, "Logs errors", "")

' ── Auth flow ────────────────────────────────────────────────────────────────
Rel(authCtrl, authSvc, "Delegates")
Rel(authSvc, userRepo, "findByEmail, create")
Rel(authSvc, winstonLogger, "Logs auth events")

' ── Users ────────────────────────────────────────────────────────────────────
Rel(usersCtrl, usersSvc, "Delegates")
Rel(usersSvc, userRepo, "findWithPackages")

' ── Packages ─────────────────────────────────────────────────────────────────
Rel(pkgCtrl, pkgSvc, "Delegates")
Rel(pkgSvc, pkgRepo, "CRUD operations")

' ── Purchase (ACID) ──────────────────────────────────────────────────────────
Rel(purchaseCtrl, purchaseSvc, "Delegates")
Rel(purchaseSvc, txFactory, "Builds transaction record")
Rel(purchaseSvc, userRepo, "incrementCredits")
Rel(purchaseSvc, txRepo, "create CREDIT_IN")
Rel(purchaseSvc, winstonLogger, "Logs purchase event")

' ── RBAC Guard ───────────────────────────────────────────────────────────────
Rel(rfGuard, creditStrategy, "Executes deduction")
Rel(rfGuard, txFactory, "Builds CREDIT_OUT record")
Rel(rfGuard, pkgRepo, "checkFeatureAccess")
Rel(rfGuard, txRepo, "create CREDIT_OUT")
Rel(rfGuard, winstonLogger, "Logs credit deductions")

' ── Transactions ─────────────────────────────────────────────────────────────
Rel(txCtrl, txSvc, "Delegates")
Rel(txSvc, txRepo, "paginate")

' ── AI ───────────────────────────────────────────────────────────────────────
Rel(aiCtrl, aiSvc, "Delegates (post-guard)")

' ── Repositories → Prisma ────────────────────────────────────────────────────
Rel(userRepo, prisma, "Uses")
Rel(pkgRepo, prisma, "Uses")
Rel(txRepo, prisma, "Uses")
Rel(prisma, db, "Reads/Writes", "TCP :5432")

@enduml
