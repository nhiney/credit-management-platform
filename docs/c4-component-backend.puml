@startuml C4_Component_Backend
!include <C4/C4_Component.puml>

LAYOUT_WITH_LEGEND()

title [C4 - Level 3] Component Diagram: NestJS API

Container_Ext(spa, "React SPA", "", "")
ContainerDb_Ext(db, "PostgreSQL", "", "")

Container_Boundary(api, "NestJS API") {

    ' Cross-cutting
    Component(correlationMw, "CorrelationIdMiddleware", "NestJS Middleware",
        "Generates UUID v4 per request.\nAttaches X-Correlation-ID to request and response.")

    Component(logInterceptor, "LoggingInterceptor", "NestJS Interceptor",
        "Logs method, path, status, latency\nfor every HTTP call with correlation ID.")

    Component(exFilter, "HttpExceptionFilter", "NestJS Exception Filter",
        "Returns standardized error envelope:\n{ success, statusCode, timestamp, path, message }.")

    Component(winstonLogger, "WinstonLogger", "Winston",
        "Structured JSON logger.\nConsole transport (dev), File transport (prod).")

    ' Security
    Component(jwtGuard, "JwtAuthGuard", "NestJS Guard - APP_GUARD",
        "Validates Bearer JWT on every route.\nSkips routes with Public() decorator.")

    Component(rfGuard, "RequireFeatureGuard", "NestJS Guard",
        "1. Resolve RequireFeature metadata.\n2. Check user has ACTIVE plan with feature.\n3. Check credits >= feature.creditCost.\n4. Atomic deduction via CreditDeductionStrategy.")

    Component(rolesGuard, "RolesGuard", "NestJS Guard",
        "Checks Roles(ADMIN) metadata.\nEnforced on admin-only endpoints.")

    ' Controllers
    Component(authCtrl, "AuthController", "NestJS Controller - /api/auth",
        "POST /register\nPOST /login")

    Component(usersCtrl, "UsersController", "NestJS Controller - /api/users",
        "GET /me - profile + active packages\nGET / - all users (Admin)")

    Component(pkgCtrl, "PackagesController", "NestJS Controller - /api/packages",
        "GET / - public list\nPOST, PATCH, DELETE - Admin CRUD")

    Component(purchaseCtrl, "PurchaseController", "NestJS Controller - /api/purchase",
        "POST / - buy a package (atomic)")

    Component(txCtrl, "TransactionsController", "NestJS Controller - /api/transactions",
        "GET /me - personal history (paginated)\nGET / - all transactions (Admin)")

    Component(aiCtrl, "AiController", "NestJS Controller - /api/ai",
        "POST /generate - image (3 credits)\nPOST /auto-post - post (1 credit)")

    ' Services
    Component(authSvc, "AuthService", "NestJS Service",
        "bcrypt hash on register, bcrypt compare on login.\nJWT signing via JwtService.")

    Component(pkgSvc, "PackagesService", "NestJS Service",
        "Package CRUD via IPackageRepository.\nSoft-delete enforced via countActiveSubscribers.")

    Component(purchaseSvc, "PurchaseService", "NestJS Service",
        "Orchestrates purchase inside Prisma transaction:\nvalidate, increment credits, create UserPackage,\nlog CREDIT_IN via TransactionFactory.")

    Component(txSvc, "TransactionsService", "NestJS Service",
        "Paginated transaction history.\nDelegates to ITransactionRepository.")

    ' Domain
    Component(txFactory, "TransactionFactory", "Factory Pattern",
        "Builds CreateTransactionInput with computed\nbalanceBefore, balanceAfter, and referenceId.")

    Component(creditStrategy, "PrepaidDeductionStrategy", "Strategy Pattern",
        "Deducts credits before AI action executes.\nCan be swapped without touching the guard.")

    ' Repositories
    Component(userRepo, "UserRepository", "Repository Pattern",
        "Implements IUserRepository.\nAll user Prisma queries go through here.")

    Component(pkgRepo, "PackageRepository", "Repository Pattern",
        "Implements IPackageRepository.\nHandles package and package_features queries.")

    Component(txRepo, "TransactionRepository", "Repository Pattern",
        "Implements ITransactionRepository.\nHandles transaction read/write operations.")

    Component(prisma, "PrismaService", "Prisma Client",
        "Global singleton wrapping PrismaClient.\nProvides transaction() for atomic operations.")
}

' Cross-cutting
Rel(spa, correlationMw, "All requests pass through", "")
Rel(correlationMw, logInterceptor, "Enriches log context", "")
Rel(logInterceptor, winstonLogger, "Writes structured logs", "")
Rel(exFilter, winstonLogger, "Logs 5xx errors", "")

' Auth
Rel(authCtrl, authSvc, "Delegates")
Rel(authSvc, userRepo, "findByEmail, create")

' Users
Rel(usersCtrl, userRepo, "findWithPackages")

' Packages
Rel(pkgCtrl, pkgSvc, "Delegates")
Rel(pkgSvc, pkgRepo, "CRUD operations")

' Purchase
Rel(purchaseCtrl, purchaseSvc, "Delegates")
Rel(purchaseSvc, txFactory, "Builds CREDIT_IN record")
Rel(purchaseSvc, userRepo, "incrementCredits")
Rel(purchaseSvc, txRepo, "create transaction")

' RBAC Guard
Rel(rfGuard, creditStrategy, "Executes deduction")
Rel(rfGuard, pkgRepo, "checkFeatureAccess")
Rel(creditStrategy, txFactory, "Builds CREDIT_OUT record")
Rel(creditStrategy, userRepo, "decrementCredits")
Rel(creditStrategy, txRepo, "create transaction")

' Transactions
Rel(txCtrl, txSvc, "Delegates")
Rel(txSvc, txRepo, "paginate")

' AI
Rel(aiCtrl, rfGuard, "Guarded by")

' Repositories -> Prisma
Rel(userRepo, prisma, "Uses")
Rel(pkgRepo, prisma, "Uses")
Rel(txRepo, prisma, "Uses")
Rel(prisma, db, "Reads/Writes", "TCP :5432")

@enduml
