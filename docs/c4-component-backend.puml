@startuml C4_Component_Backend
!include <C4/C4_Component.puml>

title [C4 - Level 3] Component Diagram: NestJS API

Container_Ext(spa, "React SPA", "React 18", "")
ContainerDb_Ext(db, "PostgreSQL", "PostgreSQL 16", "")

Container_Boundary(api, "NestJS API") {

    Component(correlationMw, "CorrelationIdMiddleware", "NestJS Middleware", "Generates UUID v4 per request. Attaches X-Correlation-ID to request and response header.")
    Component(logInterceptor, "LoggingInterceptor", "NestJS Interceptor", "Logs method, path, status, latency for every HTTP call with correlation ID.")
    Component(exFilter, "HttpExceptionFilter", "NestJS Exception Filter", "Returns standardized error envelope: { success, statusCode, timestamp, path, message }.")
    Component(winstonLogger, "WinstonLogger", "Winston", "Structured JSON logger. Console transport (dev), File transport (prod).")

    Component(jwtGuard, "JwtAuthGuard", "NestJS Guard - APP_GUARD", "Validates Bearer JWT on every route. Skips routes with Public() decorator.")
    Component(rfGuard, "RequireFeatureGuard", "NestJS Guard", "Checks plan tier and credits, then atomically deducts credits via PrepaidDeductionStrategy.")
    Component(rolesGuard, "RolesGuard", "NestJS Guard", "Checks Roles(ADMIN) metadata. Enforced on admin-only endpoints.")

    Component(authCtrl, "AuthController", "NestJS Controller - /api/auth", "POST /register and POST /login")
    Component(usersCtrl, "UsersController", "NestJS Controller - /api/users", "GET /me - profile with packages. GET / - all users (Admin)")
    Component(pkgCtrl, "PackagesController", "NestJS Controller - /api/packages", "GET / - public list. POST, PATCH, DELETE - Admin CRUD")
    Component(purchaseCtrl, "PurchaseController", "NestJS Controller - /api/purchase", "POST / - buy a package (atomic ACID transaction)")
    Component(txCtrl, "TransactionsController", "NestJS Controller - /api/transactions", "GET /me - personal history. GET / - all transactions (Admin)")
    Component(aiCtrl, "AiController", "NestJS Controller - /api/ai", "POST /generate - image (3 credits). POST /auto-post - post (1 credit)")

    Component(authSvc, "AuthService", "NestJS Service", "bcrypt hash on register, bcrypt compare on login. JWT signing via JwtService.")
    Component(pkgSvc, "PackagesService", "NestJS Service", "Package CRUD via IPackageRepository. Soft-delete enforced via countActiveSubscribers.")
    Component(purchaseSvc, "PurchaseService", "NestJS Service", "Validates package and ownership. Runs Prisma transaction: credits, UserPackage, CREDIT_IN log.")
    Component(txSvc, "TransactionsService", "NestJS Service", "Paginated transaction history. Delegates to ITransactionRepository.")

    Component(txFactory, "TransactionFactory", "Factory Pattern", "Builds CreateTransactionInput with balanceBefore, balanceAfter, and referenceId.")
    Component(creditStrategy, "PrepaidDeductionStrategy", "Strategy Pattern", "Deducts credits atomically before AI action executes. Swappable via DI token.")

    Component(userRepo, "UserRepository", "Repository Pattern", "Implements IUserRepository. All user Prisma queries isolated here.")
    Component(pkgRepo, "PackageRepository", "Repository Pattern", "Implements IPackageRepository. Handles package and package_features queries.")
    Component(txRepo, "TransactionRepository", "Repository Pattern", "Implements ITransactionRepository. Handles transaction read/write.")
    Component(prisma, "PrismaService", "Prisma Client", "Global singleton wrapping PrismaClient. Provides transaction() for atomic multi-step DB operations.")
}

Rel(spa, correlationMw, "All requests pass through")
Rel(correlationMw, logInterceptor, "Enriches log context")
Rel(logInterceptor, winstonLogger, "Writes structured logs")
Rel(exFilter, winstonLogger, "Logs 5xx errors")

Rel(authCtrl, authSvc, "Delegates")
Rel(authSvc, userRepo, "findByEmail, create")

Rel(usersCtrl, userRepo, "findWithPackages")

Rel(pkgCtrl, pkgSvc, "Delegates")
Rel(pkgSvc, pkgRepo, "CRUD operations")

Rel(purchaseCtrl, purchaseSvc, "Delegates")
Rel(purchaseSvc, txFactory, "Builds CREDIT_IN record")
Rel(purchaseSvc, userRepo, "incrementCredits")
Rel(purchaseSvc, txRepo, "create transaction")

Rel(rfGuard, creditStrategy, "Executes deduction")
Rel(rfGuard, pkgRepo, "checkFeatureAccess")
Rel(creditStrategy, txFactory, "Builds CREDIT_OUT record")
Rel(creditStrategy, userRepo, "decrementCredits")
Rel(creditStrategy, txRepo, "create transaction")

Rel(txCtrl, txSvc, "Delegates")
Rel(txSvc, txRepo, "paginate")

Rel(userRepo, prisma, "Uses")
Rel(pkgRepo, prisma, "Uses")
Rel(txRepo, prisma, "Uses")
Rel(prisma, db, "Reads/Writes", "TCP :5432")

@enduml
