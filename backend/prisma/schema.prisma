generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum TransactionType {
  CREDIT_IN
  CREDIT_OUT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum UserPackageStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  currentCredits Int      @default(0) @map("current_credits")
  role           Role     @default(USER)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  transactions Transaction[]
  userPackages UserPackage[]

  @@index([email])
  @@map("users")
}

model Package {
  id           String    @id @default(uuid())
  name         String
  description  String?
  price        Decimal   @db.Decimal(10, 2)
  creditAmount Int       @map("credit_amount")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  packageFeatures PackageFeature[]
  transactions    Transaction[]
  userPackages    UserPackage[]

  @@map("packages")
}

model Feature {
  id          String   @id @default(uuid())
  codeName    String   @unique @map("code_name")
  description String?
  creditCost  Int      @default(1) @map("credit_cost")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  packageFeatures PackageFeature[]
  transactions    Transaction[]

  @@map("features")
}

model PackageFeature {
  id        String @id @default(uuid())
  packageId String @map("package_id")
  featureId String @map("feature_id")

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([packageId, featureId])
  @@index([packageId])
  @@index([featureId])
  @@map("package_features")
}

model UserPackage {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  packageId   String            @map("package_id")
  status      UserPackageStatus @default(ACTIVE)
  purchasedAt DateTime          @default(now()) @map("purchased_at")
  expiresAt   DateTime?         @map("expires_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)

  // DB-level guard: a user can own the same package only once
  @@unique([userId, packageId])
  @@index([userId])
  @@index([userId, status])
  @@map("user_packages")
}

model Transaction {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  packageId       String?           @map("package_id")
  featureId       String?           @map("feature_id")
  amount          Int
  transactionType TransactionType   @map("transaction_type")
  status          TransactionStatus @default(COMPLETED)
  description     String?
  balanceBefore   Int               @map("balance_before")
  balanceAfter    Int               @map("balance_after")
  referenceId     String?           @unique @map("reference_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  package Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  feature Feature? @relation(fields: [featureId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([transactionType])
  @@index([status])
  @@map("transactions")
}
